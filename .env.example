# Generate with: python scripts/generate_key.py
CIPHERNOTE_KEY=base64:REPLACE_WITH_A_32_BYTE_BASE64_KEY
# Optional. Defaults to the platform's local data directory.
# CIPHERNOTE_DB=/absolute/path/to/ciphernote.db

# Optional native Streamable HTTP mode. The default remains stdio.
# CIPHERNOTE_TRANSPORT=http
# CIPHERNOTE_HOST=127.0.0.1
# CIPHERNOTE_PORT=18060
# CIPHERNOTE_HTTP_PATH=/mcp
# Generate with: openssl rand -hex 32
# CIPHERNOTE_AUTH_TOKEN_FILE=/absolute/path/to/ciphernote.token
# Required behind a reverse proxy that preserves the public Host header.
# CIPHERNOTE_ALLOWED_HOSTS=notes.example.com
# Optional direct TLS. Set both or neither.
# CIPHERNOTE_TLS_CERT=/absolute/path/to/fullchain.pem
# CIPHERNOTE_TLS_KEY=/absolute/path/to/privkey.pem


# Privacy policy: standard (v0.2-compatible), private, or strict.
# CIPHERNOTE_PRIVACY_MODE=private
# Enable the authenticated HTTPS Secure Capture page (auto-enabled for private/strict).
# CIPHERNOTE_SECURE_CAPTURE_ENABLED=true
# Encrypted draft lifetime, in seconds (60..86400).
# CIPHERNOTE_SECURE_CAPTURE_TTL_SECONDS=900
# Keep false unless you explicitly accept plaintext MCP parameters in private/strict.
# CIPHERNOTE_DIRECT_WRITE_ENABLED=false

# Optional stable random deployment subject shared by authenticated HTTP and trusted stdio in a single-user instance.
# Generate at least 32 random characters; never reuse across instances.
# CIPHERNOTE_SUBJECT_ID=REPLACE_WITH_RANDOM_DEPLOYMENT_SUBJECT

# Set true only when a trusted HTTPS reverse proxy terminates TLS and rewrites X-Forwarded-Proto.
# CIPHERNOTE_TRUST_PROXY=false
