{
  "name": "ciphernote-mcp",
  "version": "0.2.0",
  "description": "A local-first, encrypted notebook MCP server.",
  "type": "module",
  "bin": {
    "ciphernote-mcp": "src/server.js"
  },
  "scripts": {
    "start": "node src/server.js",
    "test": "npm run test:node && npm run test:python",
    "test:node": "node --test tests/*.test.js",
    "test:python": "python -m unittest discover -s tests -v"
  },
  "keywords": ["mcp", "notebook", "notes", "encryption", "local-first"],
  "license": "MIT",
  "engines": {
    "node": ">=20",
    "python": ">=3.10"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  }
}
